# AI Provider API keys (Free tier recommended: Groq or Gemini)
# Get a free Groq key at https://console.groq.com (14,400 free requests/day)
GROQ_API_KEY=your_groq_api_key_here

# Or get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides:
# AI_PROVIDER=groq  # 'groq' (default if GROQ_API_KEY is set) or 'gemini'
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# FLASK_PORT=5000
